<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(30, 30, 30); font-size: 11px; height: 20px; flex-direction: row; align-items: center; border-left-width: 5px; -unity-font-style: bold;">
        <ui:Label tabindex="-1" text="Label" parse-escape-sequences="true" display-tooltip-when-elided="true" name="labelInfo" style="color: rgb(255, 255, 255);" />
    </ui:VisualElement>
</ui:UXML>
